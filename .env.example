# ZERVIX Environment Configuration
# Copy this file to .env.local and provide your own values.
# NEVER commit .env.local or real secrets to version control.

# PostgreSQL connection string (local PGlite TCP server or hosted PostgreSQL e.g. Neon/Supabase/RDS)
# Note: pgbouncer=true&connection_limit=1 ensures clean single-backend PGlite compatibility locally.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/zervix?sslmode=disable&pgbouncer=true&connection_limit=1"

# 32+ byte random secret for signing/verifying HTTP-only session cookies and CSRF tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_64_char_cryptographically_random_hex_secret"

# Server-side Gemini API key (NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="your_server_side_key_here"

# Supported Gemini model (e.g. gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional SMTP settings for real password-reset emails (if omitted, ZERVIX explains configuration status)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="security@zervix.local"
